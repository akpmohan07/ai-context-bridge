{
  "name": "ai-context-bridge",
  "version": "1.2.0",
  "private": true,
  "description": "Chrome extension — transfer context between AI platforms.",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "test:e2e": "npm run build && playwright test",
    "e2e:login": "\"/Applications/Google Chrome.app/Contents/MacOS/Google Chrome\" --user-data-dir=\"$(pwd)/e2e/.auth/chrome-profile\"",
    "e2e:connect": "npm run build && \"/Applications/Google Chrome.app/Contents/MacOS/Google Chrome\" --remote-debugging-port=9222 --user-data-dir=\"$(pwd)/e2e/.auth/chrome-profile\""
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^29.1.1",
    "vitest": "^4.1.10",
    "wxt": "^0.20.27"
  }
}
